# ─────────────────────────────────────────────────────────────────────────────
# MegaBot — variáveis PÚBLICAS do app (Expo).
# Tudo o que começa por EXPO_PUBLIC_ é embutido no bundle e visível no telemóvel.
# Nunca coloque aqui a service_role key nem qualquer "sb_secret_…".
# Copie para .env e preencha.
# ─────────────────────────────────────────────────────────────────────────────

# Fonte de dados: "mock" (demo, sem backend) ou "supabase" (auth + tenant reais).
EXPO_PUBLIC_DATA_SOURCE=mock

# Supabase → Project Settings → API (ou Connect → App Frameworks).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Chave pública: a "publishable key" (sb_publishable_…) ou a "anon key" legada.
# Também é aceite com o nome usado pelo snippet do Supabase: EXPO_PUBLIC_SUPABASE_KEY.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Segredos de servidor (Edge Functions, gateway WhatsApp, workers) NÃO vivem aqui:
# ficam nos secrets do Supabase / do servidor, nunca com o prefixo EXPO_PUBLIC_.
